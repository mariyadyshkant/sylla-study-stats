STUDY_STATS_DB_PATH=/data/study_stats.db
# Endpoint locale esposto dall'app desktop Sylla (main.js, bind 127.0.0.1:4174).
STUDY_STATS_SOURCE_URL=http://host.docker.internal:4174/api/v1/study-stats
# In alternativa, per usare uno snapshot esportato a mano invece dell'API live:
# STUDY_STATS_EXPORT_PATH=/data/study-stats.json
INGEST_INTERVAL_SECONDS=300
